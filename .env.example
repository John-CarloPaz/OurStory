# Supabase project (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Used exclusively to send invitation emails through Supabase Auth
# (see src/lib/supabase/admin.ts). Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of this app, used in invitation and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Invitation lifetime in days (1-30). Default 7.
INVITATION_TTL_DAYS=7

# How invitation emails are delivered: "supabase" (Supabase Auth emails) or
# "console" (development: print the link and show it to the inviter).
INVITATION_EMAIL_DELIVERY=supabase
